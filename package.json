{
  "name": "crm-veronica",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:start": "node scripts/supabase.mjs start -x studio,imgproxy,mailpit,realtime,storage-api,edge-runtime,logflare,vector,supavisor,postgres-meta",
    "db:stop": "node scripts/supabase.mjs stop",
    "db:reset": "node scripts/supabase.mjs db reset",
    "db:types": "node scripts/supabase.mjs gen types typescript --local --schema public > src/lib/supabase/database.types.ts",
    "env:local": "node scripts/gerar-env.mjs",
    "setup": "npm run db:start && npm run env:local",
    "test:unit": "vitest run tests/unit",
    "test:db": "vitest run tests/integracao",
    "test:e2e": "playwright test",
    "test": "npm run db:reset && npm run test:unit && npm run test:db && npm run test:e2e",
    "ambiente:isolado": "node scripts/ambiente-isolado.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "pg": "^8.23.1",
    "supabase": "^2.122.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
